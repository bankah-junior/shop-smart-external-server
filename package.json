{
  "name": "shopsmart-external-server",
  "version": "1.0.0",
  "description": "ShopSmart External Server — E-Commerce Orders & Customer Feedback API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node seed.js",
    "seed:fresh": "node seed.js --clear",
    "seed:json": "node seedFromJson.js",
    "seed:json:fresh": "node seedFromJson.js --clear",
    "seed:json:orders": "node seedFromJson.js --orders",
    "seed:json:feedback": "node seedFromJson.js --feedback",
    "test": "echo \"No tests configured\" && exit 0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
